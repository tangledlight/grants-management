# Hosted mode: Vercel proxies to the Supabase Edge Function.
SUPABASE_EDGE_FUNCTION_URL=
# Legacy anon JWT for the function gateway. This is a public key, not a server secret.
SUPABASE_ANON_KEY=

# Optional direct local mode: leave EDGE_FUNCTION_URL empty and configure these.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Integration tests reset shared data; use only a disposable demo dataset.
TEST_BASE_URL=http://localhost:3000
ALLOW_DEMO_RESET=0
